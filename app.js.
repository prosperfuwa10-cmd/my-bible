const versionSelect = document.getElementById("version");
const startBtn = document.getElementById("startBtn");

// Save selected Bible version
versionSelect.addEventListener("change", () => {
  localStorage.setItem("bibleVersion", versionSelect.value);
});

// Load saved version
const savedVersion = localStorage.getItem("bibleVersion");
if (savedVersion) versionSelect.value = savedVersion;

// Start Reading button
startBtn.addEventListener("click", async () => {
  const version = versionSelect.value;

  const response = await fetch(`bible-data/${version}.json`);
  const bible = await response.json();

  const verses = bible.Genesis["1"];

  document.getElementById("reader").innerHTML = `
    <h2>Genesis 1 (${version.toUpperCase()})</h2>
    <div id="verses"></div>
  `;

  const versesDiv = document.getElementById("verses");

  Object.keys(verses).forEach(num => {
    versesDiv.innerHTML += `<p><strong>${num}</strong> ${verses[num]}</p>`;
  });
});

// Open selected book
const openBookBtn = document.getElementById("openBookBtn");
const bookSelect = document.getElementById("bookSelect");

openBookBtn.addEventListener("click", async () => {
  const version = versionSelect.value;
  const book = bookSelect.value;

  const response = await fetch(`bible-data/${version}.json`);
  const bible = await response.json();

  if (!bible[book]) {
    document.getElementById("reader").innerHTML =
      `<p>${book} will be added soon.</p>`;
    return;
  }

  const chapter = bible[book]["1"];
  let html = `<h2>${book} 1 (${version.toUpperCase()})</h2>`;

  for (const verse in chapter) {
    html += `<p><strong>${verse}</strong> ${chapter[verse]}</p>`;
  }

  document.getElementById("reader").innerHTML = html;
});

// Register the Service Worker
if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./service-worker.js");
  });
}
